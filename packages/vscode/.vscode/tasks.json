{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build all",
      "dependsOn": [
        "Build core (tsc)",
        "Build web server (tsc)",
        "Build web client (vite)",
        "Build extension (tsc)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "pnpm -C ../../packages/core exec tsc",
      "problemMatcher": ["$tsc"],
      "label": "Build core (tsc)"
    },
    {
      "type": "shell",
      "command": "pnpm -C ../../packages/web exec tsc",
      "problemMatcher": ["$tsc"],
      "label": "Build web server (tsc)"
    },
    {
      "type": "shell",
      "command": "pnpm -C ../../packages/web run build-client",
      "problemMatcher": [],
      "label": "Build web client (vite)"
    },
    {
      "type": "shell",
      "command": "pnpm exec tsc",
      "problemMatcher": ["$tsc"],
      "label": "Build extension (tsc)"
    }
  ]
}
