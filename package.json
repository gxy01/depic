{
  "name": "depic",
  "private": true,
  "description": "JS/TS code dependency analysis library",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "build": "rolldown -c rolldown.config.mjs && pnpm --filter @depic/core build && pnpm --filter @depic/web build && pnpm --filter @depic/cli build && pnpm --filter depic-vscode build",
    "build:demo": "node packages/cli/dist/cli.js web . demo.html",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --config oxlintrc.json packages/*/src",
    "lint:fix": "oxlint --config oxlintrc.json --fix packages/*/src"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxlint": "^1.69.0",
    "rolldown": "^1.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
